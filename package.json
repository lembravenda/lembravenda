{
  "name": "lembravenda",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:validate": "node scripts/validate-migrations.mjs",
    "test:unit": "node --test --experimental-strip-types tests/unit/products-format.test.mjs tests/unit/orders-calc.test.mjs tests/unit/orders-charge.test.mjs tests/unit/repurchase-calc.test.mjs tests/unit/first-steps.test.mjs tests/unit/phone-validation.test.mjs tests/unit/next-config.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:local": "PLAYWRIGHT_SKIP_WEBSERVER=1 PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000 playwright test",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.48.0",
    "@vercel/analytics": "^2.0.1",
    "next": "^15.1.6",
    "posthog-js": "^1.372.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
